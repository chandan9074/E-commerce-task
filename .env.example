# ---------------------------------------------------------------------------
# All variables here are OPTIONAL. The app builds and runs with none of them.
# ---------------------------------------------------------------------------

# Absolute origin used for canonical URLs, Open Graph tags, the sitemap and the
# server-side axios base URL.
#
# Leave it unset on Vercel: the deployment's own domain is detected
# automatically (VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL). Set it only
# when you have a custom domain, e.g. NEXT_PUBLIC_SITE_URL=https://aurelia.shop
#
# Do NOT add it to your host's dashboard with an empty value - define it with a
# real URL or not at all. (An empty value is handled safely and falls back, but
# it tells the app nothing.)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 0 to remove the artificial latency the mock API adds in development.
# (Latency is always disabled in production builds.)
# NEXT_PUBLIC_API_DELAY=1
